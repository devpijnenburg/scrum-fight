{
  "name": "scrum-fight-frontend-tests",
  "private": true,
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/__tests__/**/*.test.mjs"
    ],
    "transform": {},
    "moduleFileExtensions": [
      "js",
      "mjs",
      "json"
    ]
  }
}
